{
  "seed": 0,
  "dtype": "float64",
  "outdir": "outdir",
  "device": "cpu",
  "logging": {
    "level": "info"
  },
  "description": "parkinsons: corrected protocol (oversampling and selection inside training folds, C by inner CV), the paper's columns and the exact references.",
  "experiment": {
    "id": "accuracy_parkinsons_corrected",
    "kind": "accuracy"
  },
  "dataset": {
    "name": "parkinsons",
    "oversample_ratio": 0.6,
    "subset_size": 0.8,
    "scaling": "standard",
    "protocol": "corrected"
  },
  "evaluation": {
    "n_splits": 5,
    "cv_random_state": 0,
    "kernel_pca": true,
    "kpca_components": [
      2,
      3,
      4,
      5,
      6,
      7
    ],
    "inner_splits": 5,
    "C_grid": [
      0.01,
      0.0316,
      0.1,
      0.316,
      1.0,
      3.16,
      10.0,
      31.6,
      100.0
    ]
  },
  "methods": [
    {
      "name": "classical_linear",
      "kernel": "linear",
      "_comment": "Paper's 'Centralised Classical' column: linear SVM on standardised features"
    },
    {
      "name": "quantum_centralised",
      "kernel": "swap_test",
      "circuit": "centralised",
      "noise_level": 0,
      "shots": 1024
    },
    {
      "name": "quantum_distributed",
      "kernel": "swap_test",
      "circuit": "distributed",
      "noise_level": 0,
      "shots": 1024
    },
    {
      "name": "exact_squared_overlap",
      "kernel": "squared_overlap",
      "_comment": "Swap-test kernel with infinite shots and no noise (classically computable)"
    },
    {
      "name": "exact_cosine",
      "kernel": "cosine",
      "_comment": "The 'linear kernel' the paper names: x.y / (||x|| ||y||)"
    },
    {
      "name": "majority_class",
      "kernel": "majority"
    }
  ]
}
