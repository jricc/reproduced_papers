{
  "description": "Smoke run: Wine, paper protocol, the paper's three Table 1 columns (kernel SVM only). Runs in seconds.",
  "seed": 0,
  "dtype": "float64",
  "outdir": "outdir",
  "device": "cpu",
  "data_root": "../../data",
  "_comment_data_root": "Resolved against this paper folder; --data-root overrides it. The shared find_repo_root would stop at this folder, which has its own implementation.py.",
  "logging": {
    "level": "info"
  },
  "experiment": {
    "id": "defaults_wine_smoke",
