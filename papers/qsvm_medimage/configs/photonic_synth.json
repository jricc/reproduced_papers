{
    "description": "Photonic (MerLin boson-sampling) fidelity kernel vs gate QSVM and fair baselines, weak-signal regime. Reduced q-set / 3 seeds to keep SLOS tractable on CPU. 2 photons.",
    "seed": 42,
    "outdir": "outdir",
    "device": "cpu",
    "dataset": {
        "source": "synthetic",
        "synthetic": {
            "n_samples": 600,
            "ambient_dim": 768,
            "latent_dim": 50,
            "spectrum_decay": 0.9,
            "minority_fraction": 0.28,
            "signal": 0.25,
            "noise": 1.0
        }
    },
    "experiment": {
        "q_list": [4, 6, 8, 10],
        "seeds": [0, 1, 2],
        "circuit": "bsp",
        "reps": 1,
        "classifiers": ["qsvm", "qsvm_photonic", "linear_c1", "rbf_rank_matched", "linear_balanced"]
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
