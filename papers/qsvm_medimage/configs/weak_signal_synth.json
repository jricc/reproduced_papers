{
    "description": "Weak-signal regime (signal=0.25) that reproduces the paper's headline phenomenon: untuned linear SVM (C=1) collapses while QSVM avoids collapse. Used for the Tier-1 / Tier-2 comparison tables and the concentration-vs-q curve.",
    "seed": 42,
    "outdir": "outdir",
    "device": "cpu",
    "dataset": {
        "source": "synthetic",
        "synthetic": {
            "n_samples": 1000,
            "ambient_dim": 768,
            "latent_dim": 50,
            "spectrum_decay": 0.9,
            "minority_fraction": 0.28,
            "signal": 0.25,
            "noise": 1.0
        }
    },
    "experiment": {
        "q_list": [2, 3, 4, 5, 6, 8, 10, 11, 12, 16],
        "seeds": [0, 1, 2, 3, 4],
        "circuit": "bsp",
        "reps": 1,
        "classifiers": ["qsvm", "linear_c1", "rbf_c1", "rbf_rank_matched", "linear_balanced", "linear_tuned"]
    },
    "logging": {"level": "info", "save_config_snapshot": true}
}
